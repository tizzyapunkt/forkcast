# Required: single-user auth
AUTH_PASSWORD=
# At least 32 chars; used to sign session JWTs
AUTH_JWT_SECRET=

# Optional: AI-based recipe import (POST /import-recipe-from-photos).
# Without ANTHROPIC_API_KEY the endpoint returns 503 ai-import-not-configured;
# the rest of the API works normally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Per-image decoded byte limit (default 5 MB)
RECIPE_IMPORT_MAX_IMAGE_BYTES=5242880
# Combined decoded byte limit per request (default 20 MB)
RECIPE_IMPORT_MAX_TOTAL_BYTES=20971520
# Maximum images per request (default 8)
RECIPE_IMPORT_MAX_IMAGES=8
