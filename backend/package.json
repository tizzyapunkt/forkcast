{
  "name": "@forkcast/backend",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --experimental-transform-types --watch src/index.ts",
    "start": "node --experimental-transform-types src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --config ../.oxfmtrc.json src",
    "lint": "oxlint --config ../.oxlintrc.json src",
    "typecheck": "tsc --noEmit",
    "build:foods": "node --experimental-transform-types --env-file-if-exists=.env scripts/build-foods-data.ts",
    "build:foods:augment": "node --experimental-transform-types --env-file-if-exists=.env scripts/build-foods-augment.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@hono/node-server": "^1.19.14",
    "@openfoodfacts/openfoodfacts-nodejs": "2.0.0-alpha.30",
    "dotenv": "^17.4.2",
    "hono": "^4.12.14",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
