# Umami analytics — leave empty to build without tracking. Production values live in
# .env.production. UMAMI_DOMAINS (comma-separated) limits tracking to those hosts.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=

# Tally forms for the interest check, one per page language (the ID from https://tally.so/r/<id>).
# Leave empty and the form says it is not live yet. Hidden fields each form must define: hosted,
# selfhost. The page never sends an e-mail; the optional e-mail question lives on the form only.
TALLY_FORM_ID_EN=
TALLY_FORM_ID_DE=
